<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Development configuration - allows cleartext and trusts user certificates -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>

    <!-- Specific domains for payment gateway -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">demo-ipg.ctdev.comtrust.ae</domain>
        <domain includeSubdomains="true">comtrust.ae</domain>
        <domain includeSubdomains="true">ctdev.comtrust.ae</domain>
    </domain-config>
</network-security-config>